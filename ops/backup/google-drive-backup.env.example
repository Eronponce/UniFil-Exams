# Copy/install target: ~/.config/unifil-exams/google-drive-backup.env
# This file contains paths and a remote name only. Do not put OAuth tokens here.

# Host checkout containing data/unifil-exams.db and the two public directories.
UNIFIL_EXAMS_REPO=/home/eronp/UniFil-Exams

# Docker Compose container_name from compose.yml.
BACKUP_CONTAINER=unifil-exams-release

# Replace the remote name if you choose another rclone remote. The folder path
# is created/used by rclone; this package never deletes remote files.
RCLONE_DESTINATION=unifil-drive:UniFil-Exams/backups

# Optional command paths for hosts where these are not on the default PATH.
# RCLONE_BIN=/home/eronp/.local/bin/rclone
# DOCKER_BIN=/usr/bin/docker

# Optional local archive directory. The default is ignored by git.
# BACKUP_LOCAL_DIR=/home/eronp/UniFil-Exams/.backups/google-drive

# The temporary SQLite snapshot directory is intentionally fixed below the
# host data bind mount and must not be overridden.

# Optional container data path only when the deployment uses a matching bind mount.
# CONTAINER_DATA_DIR=/app/data
