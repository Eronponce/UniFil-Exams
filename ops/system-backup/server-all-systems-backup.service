[Unit]
Description=UniFil Exams system-wide Restic backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%h/.config/server-backup/system-backup.env
Environment="RESTIC_PASSWORD_FILE=%h/.config/server-backup/restic-password"
ExecStart=%h/.local/libexec/server-backup/backup-all-systems.sh
