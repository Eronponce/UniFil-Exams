# Install as ~/.config/server-backup/system-backup.env with mode 0600.
# This file contains paths and retention settings only. Never put a password,
# OAuth token, or other credential value here.

# Restic's rclone backend is mandatory. Restic encrypts and deduplicates the
# staging tree before rclone writes repository objects to Google Drive.
RESTIC_REPOSITORY=rclone:unifil-drive:Servidor-Eron/backup-restic
RESTIC_PASSWORD_FILE=/home/eronp/.config/server-backup/restic-password

# Local work root. A successful run removes only staging/<run-id>; a failed
# upload is moved to failed/<run-id> for diagnosis.
BACKUP_WORK_ROOT=/home/eronp/backups/system-wide

# Production source roots.
UNIFIL_EXAMS_ROOT=/home/eronp/UniFil-Exams
CANVA_API_ROOT=/home/eronp/Canva_Api
MIRROR_DB_PATH=/home/eronp/mirror-server/data/mirror.db
SUPABASE_ROOT=/home/eronp/supabase-docker

# Container names from production.
UNIFIL_CONTAINER=unifil-exams-release
CANVA_CONTAINER=canvas-bulk-panel
GRADE_APP_CONTAINER=grade-app
ERON_DASHBOARD_CONTAINER=eron-dashboard
SUPABASE_DB_CONTAINER=supabase-db

# Paths inside grade-app and eron-dashboard.
GRADE_APP_DB_PATH=/app/grade_lab.db
ERON_DASHBOARD_DB_PATH=/data/metrics.db
GRADE_APP_STATE_PATH=/app/state.json
GRADE_APP_ANALYSIS_PATH=/app/data_analysis
GRADE_APP_VOLUME_MOUNT=/app
GRADE_APP_ACTIVE_VOLUME=grade_app_grade_data
GRADE_APP_HISTORICAL_VOLUME=grade-app_grade_data
# GRADE_APP_IMAGE=registry.example/grade-app:latest

# Host copies retained for recovery and provenance; both use the SQLite
# backup API rather than a raw live-file copy.
GRADE_HOST_DB_PRIMARY=/home/eronp/Grade-App/grade_lab.db
GRADE_HOST_DB_SECONDARY=/home/eronp/grade_app/grade_lab.db

# Optional command overrides.
# DOCKER_BIN=/usr/bin/docker
# RESTIC_BIN=/usr/local/bin/restic
# RCLONE_BIN=/home/eronp/.local/bin/rclone
# PYTHON_BIN=/usr/bin/python3

# Retention defaults. Prune is disabled unless explicitly enabled.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
RESTIC_PRUNE=false

# Explicit recovery configuration allowlist. Each absolute source path is
# preserved beneath secrets/ (for example, /home/eronp/Canva_Api/.env becomes
# secrets/home/eronp/Canva_Api/.env). Colons are ordinary path characters and
# are not delimiters. Missing paths are logged by path only and skipped.
#
# ~/.config/rclone/rclone.conf and restic-password are deliberately excluded:
# rclone authentication and the Restic password must never be staged.
SECRET_FILES='/home/eronp/UniFil-Exams/compose.yml
/home/eronp/Canva_Api/.env
/home/eronp/Canva_Api/docker-compose.yml
/home/eronp/Grade-App/docker-compose.yml
/home/eronp/grade_app/docker-compose.yml
/home/eronp/mirror-pg/.env
/home/eronp/supabase-docker/.env
/home/eronp/supabase-docker/docker-compose.yml
/home/eronp/Eron_language_tool/docker-compose.yml
/home/eronp/eron-dashboard/docker-compose.yml
/home/eronp/logisim-proxy/Caddyfile'
